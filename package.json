{
  "name": "assura-elevate-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Assura Elevate client platform: monthly data collection, company dashboard and automated highlights.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --no-warnings server/server.js",
    "seed:demo": "node --no-warnings tools/seed_demo.js",
